# Discord application credentials (Discord Developer Portal > your app)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Only needed if HTTP interactions are ever enabled (gateway bot doesn't use it)
DISCORD_PUBLIC_KEY=

# Home guild (the Tempest server)
GUILD_ID=

# Bot owner (Discord user id for admin-only commands)
OWNER_ID=

# LLM provider for Tempest AI. Set one key; ANTHROPIC is preferred if both exist.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# HTTP health server port (Railway injects PORT automatically)
PORT=3000

# Persistent data directory. On Railway, mount a volume and point this at it.
# Defaults to ./data when unset.
DATA_DIR=

# Optional: comma-separated channel ids for the cross-server lobby relay.
# Usually configured at runtime via /lobby link instead.
LOBBY_CHANNEL_IDS=
