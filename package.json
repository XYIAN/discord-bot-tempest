{
  "name": "discord-bot-tempest",
  "version": "0.2.2",
  "description": "Tempest guild hub bot for Wittle Defender (Habby) — community, recruiting, achievements, and Tempest AI.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "setup:server": "tsx src/scripts/setup-server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "croner": "^9.0.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.8"
  }
}
